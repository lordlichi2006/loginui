<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" maxHeight="240.0" maxWidth="320.0" minHeight="240.0" minWidth="320.0" prefHeight="240.0" prefWidth="320.0" spacing="5.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.dami.loginui.LoginController">
   <children>
      <Label text="Inicio De Sesión">
         <font>
            <Font name="System Bold" size="20.0" />
         </font>
         <VBox.margin>
            <Insets bottom="10.0" />
         </VBox.margin></Label>
      <Label maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" text="Email" />
      <TextField fx:id="txtEmail" />
      <Label maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" text="Contraseña" />
      <PasswordField fx:id="txtPassword" />
      <Button fx:id="loginButton" onAction="#login" text="Iniciar Sesión">
         <VBox.margin>
            <Insets top="10.0" />
         </VBox.margin></Button>
   </children>
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
</VBox>
